# Keep demo mode enabled while developing UI without a backend.
VITE_DEMO_MODE=true
VITE_REQUIRE_AUTH=false
VITE_API_BASE_URL=/api
# Local Vite dev proxy only. Set this to an active API User id only when
# the API is running with ALLOW_DEV_AUTH=true. Leave blank for Cognito auth.
VITE_DEV_ACTOR_ID=

# Required when VITE_DEMO_MODE=false. Register the redirect URI in the Cognito app client.
VITE_COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=your-cognito-app-client-id
VITE_COGNITO_REDIRECT_URI=http://localhost:5173
VITE_COGNITO_SCOPE=openid email
